# PaperMate 云端配置模板（1.2.9）
#
# 用法：
#   cp .env.cloud.example .env
#   # 编辑 .env，然后 docker compose up -d 或 systemctl start papermate
#
# 这个文件本身可以提交进仓库（不含任何真实密钥）；`.env` 已被 .gitignore 排除。

# ============================================================ 访问控制
# 【强烈建议设置】访问口令。设了之后进入站点要先输入这个口令。
#
# 不设 + 监听 0.0.0.0 = 整个公网都能用你的 API Key 刷额度。
# 生成一个强口令：python -c "import secrets;print(secrets.token_urlsafe(24))"
PAPERMATE_ACCESS_TOKEN=

# 是否允许用下面这个服务端 Key 替所有用户调用模型。
#   1（默认）= shared 模式：管理员配一次，全组共用
#   0        = byok 模式：每人必须在页面「设置」里填自己的 Key，服务端 Key 一律忽略
# 公开分享给陌生人时用 0；课题组内部用 1 更省事。
PAPERMATE_ALLOW_SERVER_KEY=1

# Cookie 签名密钥。留空则从上方的访问口令派生（改口令会让所有登录立即失效，通常正是想要的）。
# 想让「改口令但保持大家不掉线」时，才需要单独设一个固定的长随机串。
PAPERMATE_SECRET=

# 走 HTTPS（域名 + 证书）时设为 1，让登录 Cookie 带 Secure 属性。
# 纯内网 HTTP 访问必须留空或设 0——否则浏览器会丢弃 Cookie，
# 表现为「登录成功但一直跳回登录页」。
PAPERMATE_HTTPS=


# ============================================================ 模型
# 服务端共享 Key（shared 模式下生效；byok 模式下被忽略）
DEEPSEEK_API_KEY=

# ---- 1) DeepSeek 官方（OpenAI 兼容） ----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 2) Anthropic 官方 ----
# DEEPSEEK_BASE_URL=https://api.anthropic.com
# DEEPSEEK_MODEL=claude-sonnet-4-5

# ---- 3) 萤算 Lumda（聚合） ----
# DEEPSEEK_BASE_URL=https://api.lumdatech.com/api/v1
# DEEPSEEK_MODEL=deepseek-v4-pro


# ============================================================ 运行
# 反代后面要拿真实客户端 IP 时才需要设。
# 默认只信 127.0.0.1；用 Nginx 在同机反代就够，不必改。
PAPERMATE_TRUSTED_PROXIES=127.0.0.1
